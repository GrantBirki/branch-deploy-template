#!/usr/bin/env bash

set -euo pipefail

# shellcheck source=script/env
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/env"
require_terraform

runtime_dir="$(make_runtime_dir)"
trap 'remove_runtime_dir "$runtime_dir"' EXIT

export TF_DATA_DIR="$runtime_dir/terraform-data"

terraform -chdir="$ROOT" init -backend=false -input=false

if [[ -e "$ROOT/.terraform.lock.hcl" ]]; then
  die "the built-in terraform_data provider must not create a dependency lock file"
fi

printf 'Terraform %s is ready; this module has no external provider dependencies.\n' "$TERRAFORM_VERSION"
