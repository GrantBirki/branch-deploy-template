#!/usr/bin/env bash

set -euo pipefail

# shellcheck source=script/env
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/env"
require_terraform

mode="${1:-}"
case "$mode" in
  noop|deploy) ;;
  *) die "usage: script/terraform <noop|deploy>" ;;
esac

revision="${DEPLOYMENT_SHA:-local}"
if [[ "$revision" != "local" && ! "$revision" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]]; then
  die "DEPLOYMENT_SHA must be an exact 40- or 64-character lowercase Git SHA"
fi

runtime_dir="$(make_runtime_dir)"
state_path="$runtime_dir/terraform.tfstate"
plan_path="$runtime_dir/terraform.tfplan"
export TF_DATA_DIR="$runtime_dir/terraform-data"

cleanup() {
  local original_status=$?
  local cleanup_status=0
  local resources=""

  trap - EXIT
  set +e

  if [[ -f "$state_path" ]]; then
    resources="$(terraform -chdir="$ROOT" state list 2>/dev/null)"
    if [[ -n "$resources" ]]; then
      printf 'Cleaning local Terraform state after an incomplete %s...\n' "$mode" >&2
      if ! terraform -chdir="$ROOT" destroy \
        -auto-approve \
        -input=false \
        -no-color \
        -var="revision=$revision" >&2; then
        printf 'error: cleanup destroy failed; temporary state will still be removed\n' >&2
        cleanup_status=1
      fi
    fi
  fi

  if ! remove_runtime_dir "$runtime_dir"; then
    cleanup_status=1
  fi

  if [[ $original_status -ne 0 ]]; then
    exit "$original_status"
  fi
  exit "$cleanup_status"
}

trap cleanup EXIT

terraform -chdir="$ROOT" init \
  -backend-config="path=$state_path" \
  -input=false \
  -no-color \
  -reconfigure
terraform -chdir="$ROOT" validate -no-color
terraform -chdir="$ROOT" plan \
  -input=false \
  -no-color \
  -out="$plan_path" \
  -var="revision=$revision"

if [[ "$mode" == "noop" ]]; then
  terraform -chdir="$ROOT" show -no-color "$plan_path"
  [[ ! -e "$state_path" ]] || die "noop unexpectedly wrote local state"
  printf 'Noop completed for revision %s; no state was applied.\n' "$revision"
  exit 0
fi

terraform -chdir="$ROOT" apply -auto-approve -input=false -no-color "$plan_path"

[[ -f "$state_path" ]] || die "apply did not write state to the disposable backend path"

resources="$(terraform -chdir="$ROOT" state list)"
[[ "$resources" == "terraform_data.example" ]] || die "unexpected resources in local state: ${resources:-none}"

recorded_revision="$(terraform -chdir="$ROOT" output -raw deployed_revision)"
[[ "$recorded_revision" == "$revision" ]] || die "local state recorded revision $recorded_revision instead of $revision"

printf 'Applied and verified local state at revision %s; cleanup is still pending.\n' "$revision"

terraform -chdir="$ROOT" destroy \
  -auto-approve \
  -input=false \
  -no-color \
  -var="revision=$revision"

resources="$(terraform -chdir="$ROOT" state list)"
[[ -z "$resources" ]] || die "local state is not empty after destroy: $resources"

printf 'Deployment demonstration completed; local Terraform state destroyed.\n'
