#!/usr/bin/env bash

set -euo pipefail

case "${1:-}" in
  version)
    printf 'Terraform v%s\n' "${TERRAFORM_VERSION:-missing}"
    ;;
  -chdir=*)
    command="${2:-}"
    case "$command" in
      init)
        for argument in "$@"; do
          case "$argument" in
            -backend-config=path=*)
              state_path="${argument#-backend-config=path=}"
              : > "$state_path"
              ;;
          esac
        done
        exit 0
        ;;
      validate|plan)
        exit 0
        ;;
      apply)
        if [[ "${FAKE_TERRAFORM_FAILURE:-}" == "apply-and-cleanup" ]]; then
          exit 42
        fi
        exit 0
        ;;
      output)
        printf '%s\n' "${DEPLOYMENT_SHA:-local}"
        ;;
      state)
        printf 'terraform_data.example\n'
        ;;
      destroy)
        exit 43
        ;;
      *)
        printf 'unexpected fake Terraform command: %s\n' "$command" >&2
        exit 99
        ;;
    esac
    ;;
  *)
    printf 'unexpected fake Terraform arguments: %s\n' "$*" >&2
    exit 99
    ;;
esac
